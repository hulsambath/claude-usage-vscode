{
  "name": "claude-usage-monitor",
  "displayName": "Claude & Antigravity Agent Orchestrator",
  "description": "Multi-agent orchestrator & usage monitor for Claude Code and Antigravity: Conductor pipelines, MCP agent mesh, and cross-session context bridges.",
  "version": "0.6.0",
  "publisher": "hulsambath",
  "repository": {
    "type": "git",
    "url": "https://github.com/hulsambath/claude-usage-vscode.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeUsage.show",
        "title": "Show Usage",
        "category": "Claude Usage"
      },
      {
        "command": "claudeUsage.refresh",
        "title": "Refresh",
        "category": "Claude Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeUsage.copyHandoff",
        "title": "Copy Agent Context Handoff",
        "category": "AI Usage",
        "icon": "$(copy)"
      },
      {
        "command": "claudeUsage.dispatch",
        "title": "Send Message Between Sessions (Chat ➔ Chat)",
        "category": "AI Usage",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeUsage.handoffToClaude",
        "title": "Handoff to Claude Code (from Antigravity)",
        "category": "AI Usage",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "claudeUsage.handoffToAntigravity",
        "title": "Handoff to Antigravity (from Claude Code)",
        "category": "AI Usage",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "claudeUsage.setMode",
        "title": "Switch Mode (Monitor / Conductor / MCP Mesh)",
        "category": "AI Orchestrator",
        "icon": "$(layers)"
      },
      {
        "command": "claudeUsage.startPipeline",
        "title": "Start Orchestrator Workflow Pipeline",
        "category": "AI Orchestrator",
        "icon": "$(play)"
      },
      {
        "command": "claudeUsage.advancePipeline",
        "title": "Advance to Next Pipeline Step",
        "category": "AI Orchestrator",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "claudeUsage.installMcpMesh",
        "title": "Configure Agent Mesh MCP Server in Claude & Antigravity",
        "category": "AI Orchestrator",
        "icon": "$(plug)"
      },
      {
        "command": "claudeUsage.saveHandoff",
        "title": "Save Context Bridge to Workspace (.agent-handoff.md)",
        "category": "AI Usage",
        "icon": "$(save)"
      },
      {
        "command": "claudeUsage.installBridge",
        "title": "Install Status Line Bridge (enables 5h quota)",
        "category": "Claude Usage"
      },
      {
        "command": "claudeUsage.openTranscript",
        "title": "Open Transcript",
        "category": "Claude Usage",
        "icon": "$(go-to-file)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeUsage",
          "title": "Claude Usage",
          "icon": "media/claude-usage.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "claudeUsageRight",
          "title": "Claude Usage",
          "icon": "media/claude-usage.svg"
        }
      ]
    },
    "views": {
      "claudeUsage": [
        {
          "type": "webview",
          "id": "claudeUsage.view",
          "name": "Usage"
        }
      ],
      "claudeUsageRight": [
        {
          "type": "webview",
          "id": "claudeUsage.sideView",
          "name": "Usage"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeUsage.copyHandoff",
          "when": "view == claudeUsage.view || view == claudeUsage.sideView",
          "group": "navigation@1"
        },
        {
          "command": "claudeUsage.saveHandoff",
          "when": "view == claudeUsage.view || view == claudeUsage.sideView",
          "group": "navigation@2"
        },
        {
          "command": "claudeUsage.refresh",
          "when": "view == claudeUsage.view || view == claudeUsage.sideView",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeUsage.openTranscript",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Claude & Antigravity Usage",
      "properties": {
        "claudeUsage.refreshSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "description": "How often to re-read ~/.claude and ~/.gemini."
        },
        "claudeUsage.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "default": "workspace",
          "description": "List conversations of this workspace only, or all of them."
        },
        "claudeUsage.warnAt": {
          "type": "number",
          "default": 80,
          "description": "5h quota percentage at which the status bar turns to a warning colour."
        },
        "claudeUsage.antigravityEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Antigravity token tracking and cross-agent context bridge."
        },
        "claudeUsage.agentFilter": {
          "type": "string",
          "enum": [
            "all",
            "claude",
            "antigravity"
          ],
          "default": "all",
          "description": "Filter conversations list to a specific AI agent or show all."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . -w",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
